# =============================================================================
#  SIGEC-PJ — Variables de entorno para docker compose
#  Copiar a .env y AJUSTAR los secretos antes de un despliegue real.
#      cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=sigec
POSTGRES_PASSWORD=sigec_dev_cambiar
POSTGRES_DB=sigecpj

# --- Seguridad del backend (perfil prod, sin valores por defecto) ---
# JWT_SECRET: clave HS256 en Base64 (>= 256 bits). Generar con:  openssl rand -base64 48
JWT_SECRET=c2lnZWMtcGotZGV2LXNlY3JldC1jYW1iaWFyLWVuLXByb2R1Y2Npb24tMjAyNg==

# AES_KEY: clave AES-256 en Base64 (exactamente 32 bytes). Generar con:  openssl rand -base64 32
AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
